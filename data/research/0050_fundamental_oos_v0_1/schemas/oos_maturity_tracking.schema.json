{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oos_maturity_tracking.schema.json",
  "title": "Fundamental v0.1 OOS maturity tracking view",
  "description": "A derived view only. Authoritative outcome history remains append-only in oos_outcome_ledger.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "horizons"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "horizons": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["horizon_trading_days", "status", "return_fields_available"],
        "properties": {
          "horizon_trading_days": {"enum": [60, 120, 252, 504]},
          "status": {"enum": ["PENDING", "MATURED", "UNAVAILABLE"]},
          "return_fields_available": {"type": "boolean"}
        }
      }
    }
  }
}
